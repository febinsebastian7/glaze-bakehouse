# PostgreSQL / deployment URL. Required for the database-backed catalogue,
# checkout, orders, custom requests and admin workspace.
DATABASE_URL=
# Public canonical app URL, used when sending customer review links.
NEXT_PUBLIC_APP_URL=

# Firebase web app configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_ALLOWED_EMAILS=

# Cloudinary (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (server only; the public key ID is returned to checkout per order)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (server only). WHATSAPP_BAKERY_RECIPIENT is also
# used as the configured customer-facing WhatsApp destination for order tracking.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BAKERY_RECIPIENT=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional email and review cleanup integrations (server only)
EMAIL_FROM=
EMAIL_API_KEY=
OPENAI_API_KEY=
OPENAI_REVIEW_CLEANUP_MODEL=gpt-4.1-mini

# New paid orders and custom-cake requests are delivered server-to-server.
# Paste the HTTPS https://formspree.io/f/<form-id> endpoint here.
ORDER_NOTIFICATION_PROVIDER=FORMSPREE
FORMSPREE_ORDER_ENDPOINT=

# Legacy alias accepted only for an existing admin allowlist. Prefer the
# documented ADMIN_ALLOWED_EMAILS value above.
ADMIN_EMAILS=
